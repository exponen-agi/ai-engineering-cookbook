{
  "name": "ai-engineering-cookbook",
  "version": "0.1.1",
  "description": "AI Engineering Cookbook — installable skills and hooks for Claude Code.",
  "private": false,
  "bin": {
    "ai-engineering-cookbook": "./bin/cli.js",
    "install-prompt-optimizer": "./bin/install-prompt-optimizer.js",
    "install-doc-coherence": "./bin/install-doc-coherence.js",
    "install-skill-review": "./bin/install-skill-review.js",
    "install-eval-harness": "./bin/install-eval-harness.js"
  },
  "scripts": {
    "test": "node --test",
    "lint:docs": "node scripts/check-doc-coherence.js",
    "lint:skills": "node scripts/check-skills.js skills --strict",
    "lint:evals": "node scripts/check-evals.js templates/evals --strict",
    "check:toolchain": "node scripts/check-toolchain.js",
    "build:explorer": "node scripts/build-explorer.js",
    "check:explorer": "node scripts/build-explorer.js --check"
  },
  "files": [
    "bin/",
    "skills/",
    "hooks/",
    "scripts/",
    "templates/"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exponen-agi/ai-engineering-cookbook.git"
  },
  "license": "MIT"
}
